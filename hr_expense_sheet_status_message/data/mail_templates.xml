<?xml version="1.0" encoding="utf-8" ?>
<odoo noupdate="1">
    <template id="hr_expense_template_message_submit_layout">
        <div>
            <div style="margin: 0px; padding: 0px;">
                <p style="margin: 0px; padding: 0px; font-size: 13px;">
                    Expense Report
                    <t t-out="record.name" />
                    has been submitted
                </p>
            </div>
        </div>
    </template>

    <template id="hr_expense_template_message_approve_layout">
        <div>
            <div style="margin: 0px; padding: 0px;">
                <p style="margin: 0px; padding: 0px; font-size: 13px;">
                    Expense Report
                    <t t-out="record.name" />
                    has been approved
                </p>
            </div>
        </div>
    </template>

    <template id="hr_expense_template_message_refuse_layout">
        <div>
            <div style="margin: 0px; padding: 0px;">
                <p style="margin: 0px; padding: 0px; font-size: 13px;">
                    Your Expense Report
                    <t t-out="record.name" />
                    has been refused
                    <ul class="o_timeline_tracking_value_list">
                        <li>Reason: <t t-out="reason" /></li>
                    </ul>
                </p>
            </div>
        </div>
    </template>
</odoo>
