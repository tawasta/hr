<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <record id="ir_cron_talenom_employee_csv_export" model="ir.cron">
        <field name="name">Talenom: Generate Employee CSV</field>
        <field name="model_id" ref="model_talenom_csv_export" />
        <field name="state">code</field>
        <field name="code">model._cron_generate_csv(export_type="employees")</field>
        <field name="interval_type">days</field>
        <field name="interval_number">1</field>
        <field name="numbercall">-1</field>
        <field name="active">True</field>
    </record>

    <record id="ir_cron_talenom_payroll_csv_export" model="ir.cron">
        <field name="name">Talenom: Generate Payroll CSV</field>
        <field name="model_id" ref="model_talenom_csv_export" />
        <field name="state">code</field>
        <field name="code">model._cron_generate_csv(export_type="payroll")</field>
        <field name="interval_type">days</field>
        <field name="interval_number">1</field>
        <field name="numbercall">-1</field>
        <field name="active">False</field>
    </record>

</odoo>
