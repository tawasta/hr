<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <record id="hr_expense_view_form_talenom" model="ir.ui.view">
        <field name="name">hr.expense.view.form.talenom</field>
        <field name="model">hr.expense</field>
        <field name="inherit_id" ref="hr_expense.hr_expense_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='company_id']" position="after">
                <field name="talenom_export" />
                <field
                    name="talenom_export_date"
                    readonly="1"
                    invisible="not talenom_export_date"
                />
            </xpath>
        </field>
    </record>

</odoo>
