<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record
        id="res_config_settings_view_form_inherit_hr_autofill_job_title"
        model="ir.ui.view"
    >
        <field
            name="name"
        >res.config.settings.view.form.inherit.hr.autofill.job.title</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="hr.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <xpath
                expr="//block[@name='employees_setting_container']"
                position="inside"
            >
                <setting
                    string="Default Employee Job Position"
                    help="Set the default job position for employees created from expense reports."
                >
                    <field
                        name="hr_employee_default_job_id"
                        placeholder="Select a Job Position..."
                    />
                </setting>
            </xpath>
        </field>
    </record>
</odoo>
