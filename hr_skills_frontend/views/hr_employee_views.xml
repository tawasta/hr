<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <record id="view_employee_form_inherit_hr_skills_frontend" model="ir.ui.view">
        <field name="name">hr.employee.form.inherit.hr.skills.frontend</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form" />
        <field name="arch" type="xml">
            <xpath
                expr="//field[@name='user_id'][contains(@domain, 'share')]"
                position="attributes"
            >
                <attribute name="domain">[('company_ids', 'in', company_id)]</attribute>
            </xpath>
        </field>
    </record>

</odoo>
