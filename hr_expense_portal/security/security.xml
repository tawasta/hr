<?xml version="1.0" encoding="utf-8" ?>
<odoo noupdate="1">
    <record id="group_portal_expense_access" model="res.groups">
        <field name="name">Portal: Expenses</field>
        <field name="category_id" ref="base.module_category_human_resources" />
        <field name="implied_ids" eval="[(4, ref('base.group_portal'))]" />
    </record>
    <record id="rule_hr_expense_portal_read_own" model="ir.rule">
        <field name="name">Portal: own expenses (read)</field>
        <field name="model_id" ref="hr_expense.model_hr_expense" />
        <field name="domain_force">[
            ('employee_id.user_id', '=', user.id)
        ]</field>
        <field name="groups" eval="[(4, ref('base.group_portal'))]" />
        <field name="perm_read" eval="1" />
        <field name="perm_create" eval="0" />
        <field name="perm_write" eval="0" />
        <field name="perm_unlink" eval="0" />
    </record>

    <record id="rule_hr_expense_sheet_portal_read_own" model="ir.rule">
        <field name="name">Portal: own expense reports (read)</field>
        <field name="model_id" ref="hr_expense.model_hr_expense_sheet" />
        <field name="domain_force">[
            ('employee_id.user_id', '=', user.id)
        ]</field>
        <field name="groups" eval="[(4, ref('base.group_portal'))]" />
        <field name="perm_read" eval="1" />
        <field name="perm_create" eval="0" />
        <field name="perm_write" eval="0" />
        <field name="perm_unlink" eval="0" />
    </record>

    <record id="rule_hr_employee_public_portal_own" model="ir.rule">
        <field name="name">Portal: own employee public (read)</field>
        <field name="model_id" ref="hr.model_hr_employee_public"/>
        <field name="domain_force">[
            ('user_id', '=', user.id)
        ]</field>
        <field name="groups" eval="[(4, ref('hr_expense_portal.group_portal_expense_access'))]"/>
        <field name="perm_read" eval="1"/>
        <field name="perm_create" eval="0"/>
        <field name="perm_write" eval="0"/>
        <field name="perm_unlink" eval="0"/>
    </record>

</odoo>
