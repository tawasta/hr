<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="portal_my_expenses_add_create_button"
              inherit_id="hr_expense_portal.portal_my_expenses"
              priority="60">

        <xpath expr="//t[@t-if='grouped_expenses']/div[contains(@class,'card')][1]" position="before">

            <t t-if="request.params.get('create_ok')">
                <div class="alert alert-success d-flex align-items-center" role="alert">
                    <i class="fa fa-check-circle me-2"/>
                    <div>Expense created successfully.</div>
                </div>
            </t>

            <t t-if="request.params.get('create_error')">
                <div class="alert alert-danger d-flex align-items-center" role="alert">
                    <i class="fa fa-exclamation-triangle me-2"/>
                    <div>Could not create expense. Please check required fields and try again.</div>
                </div>
            </t>

            <div class="card mb-3 border-0 shadow-sm">
                <div class="card-body d-flex flex-wrap align-items-center justify-content-between gap-2">
                    <div>
                        <div class="fw-semibold">Create a new expense</div>
                        <div class="text-muted small">Use the form in the modal to add a new expense line.</div>
                    </div>

                    <div class="d-flex gap-2">
                        <button type="button"
                                class="btn btn-primary btn-sm"
                                data-bs-toggle="modal"
                                data-bs-target="#portalCreateExpenseModal">
                            <i class="fa fa-plus me-2"/>Create expense
                        </button>
                    </div>
                </div>
            </div>

            <div class="modal fade" id="portalCreateExpenseModal" tabindex="-1"
                 aria-labelledby="portalCreateExpenseModalLabel" aria-hidden="true">
                <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
                    <div class="modal-content">

                        <form action="/my/expenses/create" method="post" enctype="multipart/form-data">
                            <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>

                            <div class="modal-header">
                                <h5 class="modal-title" id="portalCreateExpenseModalLabel">
                                    <i class="fa fa-receipt me-2"/>Create expense
                                </h5>
                                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"/>
                            </div>

                            <div class="modal-body">
                                <div class="row g-3">
                                    <!-- Speaker details -->
                                    <div class="col-12">
                                        <div class="fw-semibold">Speaker details</div>
                                        <div class="text-muted small">
                                            These details are taken from your employee/contact information.
                                        </div>
                                        <hr class="mt-2 mb-0"/>
                                    </div>

                                    <div class="col-12 col-md-6">
                                        <label class="form-label">Name</label>
                                        <input type="text"
                                               class="form-control"
                                               t-att-value="(speaker_partner and speaker_partner.name) or (employee and employee.name) or ''"
                                               readonly="readonly"/>
                                    </div>

                                    <div class="col-12 col-md-6">
                                        <label class="form-label">Personal Identification Number</label>
                                        <input type="text"
                                            class="form-control"
                                            name="speaker_ssn"
                                            id="speaker_ssn_input"
                                            placeholder="e.g. 131052-308T"
                                            autocomplete="off"/>

                                        <div id="speaker_ssn_error" class="invalid-feedback d-block" style="display:none;"></div>

                                        <div class="form-text text-muted">
                                            Will be stored encrypted (never saved in plain text).
                                        </div>
                                    </div>

                                    <div class="col-12 col-md-6">
                                        <label class="form-label">Bank account (IBAN)</label>
                                        <input type="text"
                                               class="form-control"
                                               t-att-value="speaker_iban or ''"/>
                                    </div>

                                    <div class="col-12">
                                        <hr class="my-2"/>
                                    </div>

                                    <!-- Tempus Dominus date -->
                                    <div class="col-12 col-md-4">
                                        <label class="form-label">Date <span class="text-danger">*</span></label>

                                        <div class="input-group date" id="expense_date_picker">

                                            <input type="text"
                                                class="form-control datetimepicker-input"
                                                name="date"
                                                id="expense_date_input"
                                                t-att-value="today_fi or ''"
                                                placeholder="dd.MM.yyyy"
                                                autocomplete="off"
                                                required="required"/>

                                            <span class="input-group-text" style="cursor:pointer;">
                                                <i class="fa fa-calendar"/>
                                            </span>

                                        </div>


                                        <div class="form-text text-muted">Format: dd.MM.yyyy</div>
                                    </div>

                                    <div class="col-12 col-md-8">
                                        <label class="form-label">Category <span class="text-danger">*</span></label>
                                        <select class="form-select" name="product_id" required="required">
                                            <option value="">Select category…</option>
                                            <t t-if="products">
                                                <t t-foreach="products" t-as="p">
                                                    <option t-att-value="p.id"><t t-esc="p.display_name"/></option>
                                                </t>
                                            </t>
                                        </select>
                                    </div>

                                    <div class="col-12">
                                        <label class="form-label">Description <span class="text-danger">*</span></label>
                                        <input type="text"
                                               class="form-control"
                                               name="name"
                                               placeholder="e.g. Taxi to customer meeting"
                                               required="required"/>
                                    </div>

                                    <div class="col-12 col-md-4">
                                        <label class="form-label">Quantity <span class="text-danger">*</span></label>
                                        <input type="number"
                                               class="form-control"
                                               name="quantity"
                                               step="0.01"
                                               min="0.01"
                                               value="1"
                                               required="required"/>
                                    </div>

                                    <div class="col-12 col-md-4">
                                        <label class="form-label">Paid By</label>
                                        <select class="form-select" name="payment_mode">
                                            <option value="own_account">Employee (to reimburse)</option>
                                            <option value="company_account">Company</option>
                                        </select>
                                    </div>

                                    <div class="col-12 col-md-4">
                                        <label class="form-label">Receipt</label>
                                        <input type="file" class="form-control" name="receipt" accept="image/*,application/pdf"/>
                                        <div class="form-text">Optional: upload receipt (image or PDF).</div>
                                    </div>

                                    <div class="col-12">
                                        <label class="form-label">Internal Notes</label>
                                        <textarea class="form-control" name="description" rows="3"
                                                  placeholder="Optional notes…"></textarea>
                                    </div>

                                </div>
                            </div>

                            <div class="modal-footer">
                                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                                <button type="submit" class="btn btn-primary">
                                    <i class="fa fa-save me-2"/>Create
                                </button>
                            </div>

                        </form>

                    </div>
                </div>
            </div>

        </xpath>

    </template>

</odoo>
