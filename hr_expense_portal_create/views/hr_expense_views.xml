<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <record id="hr_expense_view_form_show_mileage_review_fields" model="ir.ui.view">
        <field name="name">hr.expense.view.form.show.mileage.review.fields</field>
        <field name="model">hr.expense</field>
        <field name="inherit_id" ref="hr_expense.hr_expense_view_form"/>
        <field name="arch" type="xml">

            <xpath expr="//div[@class='oe_title']/h1" position="after">
                <group string="Mileage Reimbursement Review">
                    <group>
                        <field name="quantity" readonly="1"/>
                        <field
                            name="total_amount_currency"
                            string="Approved Amount"
                            widget="monetary"
                            options="{'currency_field': 'currency_id'}"
                            readonly="not is_editable"
                        />
                    </group>
                </group>
            </xpath>

        </field>
    </record>

</odoo>