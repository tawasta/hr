<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <record id="view_hr_employee_form_hide_core_ssn_and_add_button" model="ir.ui.view">
        <field name="name">hr.employee.form.hide.core.ssn.add.decrypt.button</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form" />
        <field name="arch" type="xml">

            <!-- Piilota coren kentät -->
            <xpath expr="//field[@name='ssnid']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='identification_id']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>

            <!-- Nappi button_boxiin -->
            <xpath expr="//div[@name='button_box']" position="inside">
                <button
                    string="Show Personal ID"
                    type="object"
                    name="action_decrypt_employee_social_security_number"
                    groups="social_security_number_management.group_decrypt_social_security_number"
                />
            </xpath>

        </field>
    </record>

</odoo>
