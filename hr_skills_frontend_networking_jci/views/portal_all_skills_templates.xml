<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <template
        id="portal_all_skills_networking_partner_info"
        inherit_id="hr_skills_frontend.portal_all_skills"
        priority="101"
    >
        <xpath
            expr="//div[contains(@class, 'card-header') and contains(@class, 'bg-200')]/div[contains(@class, 'justify-content-between')]"
            position="replace"
        >

            <t t-if="groupby == 'employee'">
                <t t-set="emp" t-value="records[0].employee_id" />
                <t t-set="partner" t-value="emp.user_id.partner_id" />

                <div class="py-2">

                    <!-- TOP ROW -->
                    <div class="d-flex align-items-start justify-content-between gap-3">

                        <!-- Identity -->
                        <div class="d-flex align-items-center gap-3">
                            <img
                                t-if="emp"
                                class="rounded-circle o_avatar flex-shrink-0"
                                t-att-src="image_data_uri(emp.avatar_128)"
                            />

                            <div>
                                <div class="d-flex align-items-center gap-2 flex-wrap">
                                    <h4 class="mb-0 fw-bold text-body">
                                        <span t-esc="emp and emp.name or '—'" />
                                    </h4>

                                    <span
                                        t-if="partner and partner.function"
                                        class="badge rounded-pill text-bg-light border fw-normal"
                                    >
                                        <span t-esc="partner.function" />
                                    </span>
                                </div>

                                <div
                                    class="d-flex align-items-center gap-2 flex-wrap mt-1 small text-muted"
                                >
                                    <span t-if="emp.department_id">
                                        <i class="fa fa-building-o me-1" />
                                        <span t-esc="emp.department_id.name" />
                                    </span>

                                    <span t-if="partner and partner.employer">
                                        <span class="mx-1">·</span>
                                        <span t-esc="partner.employer" />
                                    </span>
                                </div>
                            </div>
                        </div>

                        <!-- Actions -->
                        <div class="d-flex align-items-center gap-2 flex-shrink-0">
                            <a
                                t-if="partner and partner.website"
                                t-att-href="partner.website"
                                target="_blank"
                                class="btn btn-outline-secondary btn-sm rounded-pill px-3"
                            >
                                <i class="fa fa-globe me-1" />
                                Website
                            </a>

                            <a
                                t-if="partner and partner.linkedin_url"
                                t-att-href="partner.linkedin_url"
                                target="_blank"
                                class="btn btn-outline-secondary btn-sm rounded-pill px-3"
                            >
                                <i class="fa fa-linkedin-square me-1" />
                                LinkedIn
                            </a>

                            <span
                                class="badge text-bg-light border rounded-pill px-3 py-2"
                            >
                                <t t-esc="len(records)" /> items
                            </span>
                        </div>
                    </div>

                    <!-- META ROW -->
                    <div t-if="partner" class="mt-3 pt-3 border-top">
                        <div class="row g-3 small">

                            <div t-if="partner.senator_number" class="col-6 col-md-3">
                                <div
                                    class="text-uppercase text-muted fw-semibold"
                                    style="font-size: .72rem;"
                                >
                                    Senator number
                                </div>
                                <div class="fw-semibold text-body">
                                    <span t-esc="partner.senator_number" />
                                </div>
                            </div>

                            <div
                                t-if="partner.other_language_skill"
                                class="col-6 col-md-3"
                            >
                                <div
                                    class="text-uppercase text-muted fw-semibold"
                                    style="font-size: .72rem;"
                                >
                                    Other languages
                                </div>
                                <div class="fw-semibold text-body">
                                    <span t-esc="partner.other_language_skill" />
                                </div>
                            </div>

                            <div
                                t-if="partner.education_level_id"
                                class="col-6 col-md-3"
                            >
                                <div
                                    class="text-uppercase text-muted fw-semibold"
                                    style="font-size: .72rem;"
                                >
                                    Education level
                                </div>
                                <div class="fw-semibold text-body">
                                    <span t-esc="partner.education_level_id.name" />
                                </div>
                            </div>

                            <div
                                t-if="partner.other_education_or_degree"
                                class="col-6 col-md-3"
                            >
                                <div
                                    class="text-uppercase text-muted fw-semibold"
                                    style="font-size: .72rem;"
                                >
                                    Other educations or degrees
                                </div>
                                <div class="fw-semibold text-body">
                                    <span t-esc="partner.other_education_or_degree" />
                                </div>
                            </div>

                        </div>
                    </div>

                </div>
            </t>

            <t t-else="">
                <div class="d-flex align-items-center justify-content-between">
                    <div class="d-flex align-items-center gap-2">
                        <t t-if="groupby == 'department'">
                            <i class="fa fa-building-o" />
                            <strong>
                                <span
                                    t-esc="records[0].department_id and records[0].department_id.name or 'No Department'"
                                />
                            </strong>
                        </t>

                        <t t-if="groupby == 'type'">
                            <i class="fa fa-tags" />
                            <strong>
                                <span
                                    t-esc="records[0].skill_type_id and records[0].skill_type_id.name or '—'"
                                />
                            </strong>
                        </t>

                        <t t-if="groupby == 'skill'">
                            <i class="fa fa-code" />
                            <strong>
                                <span
                                    t-esc="records[0].skill_id and records[0].skill_id.name or '—'"
                                />
                            </strong>
                        </t>

                        <t t-if="groupby == 'level'">
                            <i class="fa fa-signal" />
                            <strong>
                                <span
                                    t-esc="records[0].skill_level_id and records[0].skill_level_id.name or '—'"
                                />
                            </strong>
                        </t>

                        <t t-if="groupby == 'none'">
                            <strong>All skills</strong>
                        </t>
                    </div>

                    <span class="badge text-bg-light">
                        <t t-esc="len(records)" /> items
                    </span>
                </div>
            </t>

        </xpath>
    </template>

    <template
        id="portal_skills_modal_body_hide_profile_fields"
        inherit_id="hr_skills_frontend.portal_skills_modal_body"
        priority="101"
    >
        <xpath
            expr="//div[@id='profile-block']/ancestor::div[contains(@class, 'mb-4')][1]"
            position="replace"
        />
    </template>
</odoo>
